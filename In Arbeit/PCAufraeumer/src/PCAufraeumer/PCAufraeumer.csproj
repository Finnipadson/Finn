<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PCAufraeumer</AssemblyName>
    <RootNamespace>PCAufraeumer</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>PC Aufräumer &amp; Systemübersicht</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <!-- Nur 64-Bit-VLC mitliefern und ungenutzte VLC-Module weglassen (Oberflächen, Lua, Visualisierungen) -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <!-- Ungenutzte VLC-Module (eigene VLC-Oberflächen, Visualisierungen) nach dem Veröffentlichen entfernen: spart ~20 MB -->
  <Target Name="TrimVlcPlugins" AfterTargets="Publish">
    <ItemGroup>
      <_VlcUnused Include="$(PublishDir)libvlc\win-x64\plugins\gui\**;$(PublishDir)libvlc\win-x64\plugins\visualization\**" />
    </ItemGroup>
    <Delete Files="@(_VlcUnused)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.5" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2792.45" />
    <PackageReference Include="System.IO.Hashing" Version="8.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PCAufraeumer.Tests" />
  </ItemGroup>

</Project>
