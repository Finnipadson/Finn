<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design „Graphit“ (hell): warmes Hellgrau, derselbe Bernstein-Akzent etwas dunkler -->
    <Color x:Key="WindowBgColor">#F1EFEB</Color>
    <SolidColorBrush x:Key="WindowBg" Color="#F1EFEB"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#F1EFEB"/>
    <SolidColorBrush x:Key="CardBg" Color="#FBFAF8"/>
    <SolidColorBrush x:Key="CardBgHover" Color="#EBE8E2"/>
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Border" Color="#DEDAD3"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#C9C4BA"/>
    <SolidColorBrush x:Key="Text" Color="#23211D"/>
    <SolidColorBrush x:Key="TextMuted" Color="#6E695F"/>
    <SolidColorBrush x:Key="Accent" Color="#C9871F"/>
    <SolidColorBrush x:Key="AccentHover" Color="#D69632"/>
    <SolidColorBrush x:Key="AccentText" Color="#1A1814"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#F4E5C8"/>
    <SolidColorBrush x:Key="Danger" Color="#C2412D"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#F7DDD5"/>
    <SolidColorBrush x:Key="Good" Color="#4C8838"/>
    <SolidColorBrush x:Key="Warn" Color="#A8700F"/>
    <SolidColorBrush x:Key="Neutral" Color="#A09A8F"/>
    <SolidColorBrush x:Key="Track" Color="#E4E0D9"/>
    <SolidColorBrush x:Key="RowAlt" Color="#FBFAF8"/>
    <SolidColorBrush x:Key="RowSelected" Color="#F3E6CD"/>
    <SolidColorBrush x:Key="GroupBg" Color="#F0EDE7"/>
    <SolidColorBrush x:Key="SegmentBg" Color="#E7E4DE"/>
    <SolidColorBrush x:Key="SegmentSelected" Color="#FFFFFF"/>
</ResourceDictionary>
