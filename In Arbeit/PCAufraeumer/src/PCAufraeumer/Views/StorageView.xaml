<UserControl x:Class="PCAufraeumer.Views.StorageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PCAufraeumer.Views">
    <DockPanel Margin="24,20,24,16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Speicher" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="12"
                       Text="Speicherplatz-Karte: Jede Kachel ist so groß, wie der Ordner bzw. die Datei Platz braucht. Klick auf eine Kachel zoomt hinein. Es wird nur gelesen, nichts verändert."/>
        </StackPanel>

        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <ComboBox ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget}" DisplayMemberPath="Label" Width="430" Margin="0,0,10,6"
                      VerticalContentAlignment="Center" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}"/>
            <Button Command="{Binding BrowseCommand}" Margin="0,0,10,6" IsEnabled="{Binding IsBusy, Converter={StaticResource Not}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE8DA;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock Text="Ordner wählen …"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding AnalyzeCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,6" Padding="16,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock Text="Analysieren"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding CancelCommand}" Margin="0,0,10,6" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="Abbrechen"/>
            </Button>
        </WrapPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Left" IsIndeterminate="True" Width="80" Height="4" Margin="0,0,10,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- Karte -->
            <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Left" Command="{Binding UpCommand}" Style="{StaticResource GhostButton}" ToolTip="Eine Ebene höher" Margin="0,0,6,0"
                                Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" FontSize="13"/>
                        </Button>
                        <Button DockPanel.Dock="Right" Command="{Binding ShowInExplorerCommand}" CommandParameter="{Binding Current}" Margin="6,0,0,0" Padding="10,4"
                                Visibility="{Binding HasMap, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Im Explorer öffnen"/>
                            </StackPanel>
                        </Button>
                        <ItemsControl ItemsSource="{Binding Breadcrumb}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Padding="4,2" Margin="0"
                                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        </Button>
                                        <TextBlock Text="›" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="2,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding HoverText}" Style="{StaticResource Muted}" FontSize="12" Margin="2,0,0,8"
                               TextTrimming="CharacterEllipsis" MinHeight="16"/>
                    <Grid>
                        <v:TreemapControl Node="{Binding Current}" HoverNode="{Binding HoverNode, Mode=OneWayToSource}"
                                          OpenCommand="{Binding OpenCommand}" Background="{DynamicResource InputBg}"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                    Visibility="{Binding HasMap, Converter={StaticResource BoolToVisInv}}">
                            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="Noch keine Karte" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                            <TextBlock Text="Laufwerk wählen und „Analysieren“ klicken." Style="{StaticResource Muted}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Liste der größten Einträge -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12" Margin="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,0,8">
                        <TextBlock Text="Größte Einträge" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Current.Name, Mode=OneWay}"/><Run Text="{Binding Current.SizeText, Mode=OneWay, StringFormat='  ·  {0}'}"/>
                        </TextBlock>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Entries}" SelectedItem="{Binding SelectedEntry}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3" Background="Transparent" ToolTip="{Binding FullPath}">
                                    <Grid.InputBindings>
                                        <MouseBinding Gesture="LeftDoubleClick"
                                                      Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    </Grid.InputBindings>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Öffnen / hineinzoomen"
                                                      Command="{Binding PlacementTarget.Tag.OpenCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Im Explorer zeigen"
                                                      Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid.Tag>
                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                    </Grid.Tag>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Grid.RowSpan="2" VerticalAlignment="Top" Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource Mono}" Margin="8,0,0,0"/>
                                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Height="3" Background="{DynamicResource Border}" CornerRadius="1.5" VerticalAlignment="Center">
                                            <Border Height="3" Background="{DynamicResource Accent}" CornerRadius="1.5" HorizontalAlignment="Left"
                                                    Width="{Binding ShareOfParent, Converter={StaticResource ShareWidth}, ConverterParameter=230}"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding ShareText}" Style="{StaticResource Muted}" FontSize="11" Margin="8,0,0,0" MinWidth="44" TextAlignment="Right"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
