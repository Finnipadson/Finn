<UserControl x:Class="PCAufraeumer.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:PCAufraeumer.Views">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding OpenCommand}" ToolTip="Gespeicherte Ergebnisliste öffnen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Öffnen"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SaveAsCommand}" Margin="0" ToolTip="Ergebnisliste speichern, um später weiterzumachen">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Speichern unter …"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Ergebnisse" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}">
                    <Run Text="{Binding Header, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding TotalSummary, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- Filterleiste -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,10">
            <Grid Width="300" Margin="0,0,10,6">
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="30,6,8,6"/>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="10,0,0,0" HorizontalAlignment="Left"
                           Foreground="{DynamicResource TextMuted}" IsHitTestVisible="False"/>
            </Grid>
            <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding CategoryFilter}" DisplayMemberPath="Label"
                      Width="190" Margin="0,0,10,6" VerticalContentAlignment="Center"/>
            <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding TypeFilter}" Width="140" Margin="0,0,14,6"/>
            <CheckBox Content="Nur ausgewählte" IsChecked="{Binding OnlySelected}" Margin="0,0,14,6"/>
            <CheckBox Content="Gelöschte ausblenden" IsChecked="{Binding HideDeleted}" Margin="0,0,14,6"/>
            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,0,6" FontSize="12"
                       Text="Spaltenköpfe anklicken zum Sortieren."/>
        </WrapPanel>

        <!-- Liste + Vorschau -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="400" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid x:Name="Grid" ItemsSource="{Binding View}" SelectedItem="{Binding SelectedItem}"
                      LoadingRow="Grid_LoadingRow" RowHeight="46" CanUserResizeColumns="True" CanUserSortColumns="True"
                      CanUserReorderColumns="True">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                <Setter Property="Opacity" Value="0.45"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <StackPanel>
                                                <Border Background="{DynamicResource GroupBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="10,6">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Padding="10,3" Margin="0" FontSize="12"
                                                                Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding Items}">
                                                            <TextBlock Text="Alle in dieser Gruppe auswählen / abwählen"/>
                                                        </Button>
                                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold">
                                                            <Run Text="{Binding Name, Mode=OneWay}"/>
                                                            <Run Text="{Binding ItemCount, Mode=OneWay, StringFormat='({0} Dateien)'}" Foreground="{DynamicResource TextMuted}" FontWeight="Normal"/>
                                                        </TextBlock>
                                                    </DockPanel>
                                                </Border>
                                                <ItemsPresenter/>
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Löschen" Width="70" SortMemberPath="IsSelected">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}"
                                              HorizontalAlignment="Center" ToolTip="Zum Löschen freigeben"
                                              Visibility="{Binding IsKeep, Converter={StaticResource BoolToVisInv}}"/>
                                    <Border Background="{DynamicResource Good}" CornerRadius="4" Padding="5,1" HorizontalAlignment="Center"
                                            Visibility="{Binding IsKeep, Converter={StaticResource BoolToVis}}" ToolTip="Diese Kopie bleibt erhalten">
                                        <TextBlock Text="BLEIBT" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Vorschau" Width="66" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="56" Height="38">
                                    <TextBlock Text="{Binding TypeLabel, Converter={StaticResource TypeGlyph}}" Style="{StaticResource Icon}"
                                               FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource TextMuted}"/>
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,56,38" RadiusX="4" RadiusY="4"/>
                                        </Image.Clip>
                                    </Image>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Dateiname" Width="220" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Pfad" Width="240" SortMemberPath="Directory">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Directory}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" Foreground="{DynamicResource TextMuted}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Größe" Binding="{Binding Size, Converter={StaticResource Bytes}}" SortMemberPath="Size" Width="80"/>
                    <DataGridTextColumn Header="Dateityp" Binding="{Binding TypeLabel}" Width="90"/>
                    <DataGridTextColumn Header="Zuletzt geöffnet" Binding="{Binding LastAccess, Converter={StaticResource Date}}" SortMemberPath="LastAccess" Width="118"/>
                    <DataGridTextColumn Header="Zuletzt geändert" Binding="{Binding LastWrite, Converter={StaticResource Date}}" SortMemberPath="LastWrite" Width="118"/>
                    <DataGridTextColumn Header="Grundlage" Binding="{Binding BasisLabel}" SortMemberPath="Basis" Width="110"/>
                    <DataGridTemplateColumn Header="Grund des Vorschlags" Width="*" MinWidth="200" SortMemberPath="Reason">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Reason}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Keine Funde für diese Filter." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       IsHitTestVisible="False" x:Name="EmptyHint" Visibility="Collapsed"/>

            <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="8" HorizontalAlignment="Stretch" Background="Transparent"/>

            <v:PreviewPanel Grid.Column="2" Grid.RowSpan="2" Item="{Binding SelectedItem}"/>

            <!-- Temp / Cache -->
            <Expander Grid.Row="1" IsExpanded="True" Margin="0,10,0,0" Foreground="{DynamicResource Text}">
                <Expander.Header>
                    <TextBlock FontWeight="SemiBold" FontSize="14">
                        <Run Text="Temp-/Cache-Dateien"/>
                        <Run Text="– eigener Bereich, wird direkt gelöscht (nicht Papierkorb)" FontWeight="Normal" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                    </TextBlock>
                </Expander.Header>
                <Border Style="{StaticResource Card}" Margin="0,6,0,0" Padding="6">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding TempTargets}" MaxHeight="230">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="6,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="230"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <Border Style="{StaticResource Badge}" Background="{DynamicResource DangerSoft}"
                                                        Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}" ToolTip="Braucht Adminrechte – Windows fragt beim Löschen nach">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Admin" FontSize="10"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,14,0">
                                            <Run Text="{Binding Size, Converter={StaticResource Bytes}, Mode=OneWay}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="3" Text="{Binding Status}" Style="{StaticResource Muted}" VerticalAlignment="Center" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="6,6,6,2">
                            <Button DockPanel.Dock="Right" Command="{Binding RecheckBrowsersCommand}" Padding="10,4" Margin="0" FontSize="12">
                                <TextBlock Text="Browser erneut prüfen"/>
                            </Button>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"
                                       Text="Browser-Caches lassen sich nur bei geschlossenem Browser leeren. Gerade benutzte Dateien werden übersprungen."/>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Expander>
        </Grid>

        <!-- Fußleiste -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SelectNoneCommand}">
                        <TextBlock Text="Auswahl aufheben"/>
                    </Button>
                    <Button Command="{Binding CleanTempCommand}" Style="{StaticResource DangerButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Temp/Cache endgültig leeren …"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding DeleteSelectedCommand}" Style="{StaticResource PrimaryButton}" Margin="0" Padding="18,9">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock>
                                <Run Text="In den Papierkorb"/><Run Text="{Binding SelectionCount, Mode=OneWay, StringFormat=' ({0})'}"/>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectionSummary}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding TempSummary}" Style="{StaticResource Muted}" FontSize="12"
                               Visibility="{Binding TempSummary, Converter={StaticResource NullToVis}}"/>
                    <TextBlock Text="{Binding WorkStatus}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding WorkStatus, Converter={StaticResource NullToVis}}"/>
                    <ProgressBar Value="{Binding WorkPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,4,0,0" Width="300" HorizontalAlignment="Left"
                                 Visibility="{Binding IsWorking, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
