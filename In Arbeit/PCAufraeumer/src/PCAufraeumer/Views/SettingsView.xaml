<UserControl x:Class="PCAufraeumer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,14,14">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Einstellungen" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,14,16">
                <Run Text="Änderungen werden sofort gespeichert:"/>
                <Run Text="{Binding SettingsPath, Mode=OneWay}"/>
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Darstellung" Style="{StaticResource H2}"/>
                            <CheckBox Content="Dunkles Design (Dark Mode)" IsChecked="{Binding DarkMode}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Zeiträume" Style="{StaticResource H2}"/>
                            <TextBlock Text="Videos gelten als „lange nicht geöffnet“ nach" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding VideoPeriods}" SelectedItem="{Binding VideoPeriod}" DisplayMemberPath="Label" Width="150"/>
                                <TextBox Text="{Binding VideoCustomDays, UpdateSourceTrigger=LostFocus}" Width="80" Margin="8,0,4,0"
                                         Visibility="{Binding VideoCustom, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Tagen" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                           Visibility="{Binding VideoCustom, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <TextBlock Text="Downloads/Installer gelten als „alt“ nach" Style="{StaticResource Label}" Margin="0,12,0,1"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding DownloadPeriods}" SelectedItem="{Binding DownloadPeriod}" DisplayMemberPath="Label" Width="150"/>
                                <TextBox Text="{Binding DownloadCustomDays, UpdateSourceTrigger=LostFocus}" Width="80" Margin="8,0,4,0"
                                         Visibility="{Binding DownloadCustom, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Tagen" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                           Visibility="{Binding DownloadCustom, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Kategorien &amp; Größen" Style="{StaticResource H2}"/>
                            <CheckBox Content="Alte Videos/Clips" IsChecked="{Binding CategoryVideos}" Margin="0,3"/>
                            <CheckBox Content="Doppelte Dateien" IsChecked="{Binding CategoryDuplicates}" Margin="0,3"/>
                            <CheckBox Content="Temp-/Cache-Dateien" IsChecked="{Binding CategoryTemp}" Margin="0,3"/>
                            <CheckBox Content="Alte Downloads/Installer" IsChecked="{Binding CategoryDownloads}" Margin="0,3"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Nur Dateien größer als" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding MinSizeMB, UpdateSourceTrigger=LostFocus}" Width="70"/>
                                <TextBlock Text="MB (0 = aus)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Duplikate erst ab" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding DuplicateMinKB, UpdateSourceTrigger=LostFocus}" Width="70"/>
                                <TextBlock Text="KB" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Internet &amp; Datenschutz" Style="{StaticResource H2}"/>
                            <CheckBox IsChecked="{Binding NvidiaOnlineCheck}">
                                <TextBlock Text="NVIDIA-Treiberversion automatisch online prüfen (sendet nur das Grafikkartenmodell an nvidia.com)" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                       Text="Sonst sendet die App nichts ins Internet. Die Windows-Update-Suche startet nur, wenn du auf der Treiber-Seite auf „Über Windows Update prüfen“ klickst."/>
                            <Button Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <TextBlock Text="Datenordner öffnen (Einstellungen, Protokolle, Ergebnislisten)"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Scan-Ordner" Style="{StaticResource H2}"/>
                            <ListBox ItemsSource="{Binding ScanFolders}" SelectedItem="{Binding SelectedScanFolder}" Height="100"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Command="{Binding AddScanFolderCommand}"><TextBlock Text="Hinzufügen"/></Button>
                                <Button Command="{Binding RemoveScanFolderCommand}"><TextBlock Text="Entfernen"/></Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ausschlussliste (Ordner nie anfassen)" Style="{StaticResource H2}"/>
                            <ListBox ItemsSource="{Binding ExcludedFolders}" SelectedItem="{Binding SelectedExcludedFolder}" Height="100"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Command="{Binding AddExcludedFolderCommand}"><TextBlock Text="Hinzufügen"/></Button>
                                <Button Command="{Binding RemoveExcludedFolderCommand}"><TextBlock Text="Entfernen"/></Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ausnahmeliste (Dateien nie wieder vorschlagen)" Style="{StaticResource H2}"/>
                            <ListBox ItemsSource="{Binding ExceptionFiles}" SelectedItem="{Binding SelectedException}" Height="120"/>
                            <Button Command="{Binding RemoveExceptionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <TextBlock Text="Ausgewählte Datei wieder vorschlagen lassen"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Fest geschützt (nicht änderbar)" Style="{StaticResource H2}"/>
                            <ItemsControl ItemsSource="{Binding ProtectedRoots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Good}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="440"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
