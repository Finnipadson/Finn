<UserControl x:Class="PCAufraeumer.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,14,14">
        <StackPanel MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Einstellungen" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,14,16">
                <Run Text="Änderungen werden sofort gespeichert:"/>
                <Run Text="{Binding SettingsPath, Mode=OneWay}"/>
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Darstellung" Style="{StaticResource H2}"/>
                            <CheckBox Content="Dunkles Design (Dark Mode)" IsChecked="{Binding DarkMode}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Zeiträume" Style="{StaticResource H2}"/>
                            <TextBlock Text="Videos gelten als „lange nicht geöffnet“ nach" Style="{StaticResource Label}"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding VideoPeriods}" SelectedItem="{Binding VideoPeriod}" DisplayMemberPath="Label" Width="150"/>
                                <TextBox Text="{Binding VideoCustomDays, UpdateSourceTrigger=LostFocus}" Width="80" Margin="8,0,4,0"
                                         Visibility="{Binding VideoCustom, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Tagen" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                           Visibility="{Binding VideoCustom, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <TextBlock Text="Downloads/Installer gelten als „alt“ nach" Style="{StaticResource Label}" Margin="0,12,0,1"/>
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding DownloadPeriods}" SelectedItem="{Binding DownloadPeriod}" DisplayMemberPath="Label" Width="150"/>
                                <TextBox Text="{Binding DownloadCustomDays, UpdateSourceTrigger=LostFocus}" Width="80" Margin="8,0,4,0"
                                         Visibility="{Binding DownloadCustom, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="Tagen" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                           Visibility="{Binding DownloadCustom, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Kategorien &amp; Größen" Style="{StaticResource H2}"/>
                            <CheckBox Content="Alte Videos/Clips" IsChecked="{Binding CategoryVideos}" Margin="0,3"/>
                            <CheckBox Content="Doppelte Dateien" IsChecked="{Binding CategoryDuplicates}" Margin="0,3"/>
                            <CheckBox Content="Temp-/Cache-Dateien" IsChecked="{Binding CategoryTemp}" Margin="0,3"/>
                            <CheckBox Content="Alte Downloads/Installer" IsChecked="{Binding CategoryDownloads}" Margin="0,3"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Text="Nur Dateien größer als" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding MinSizeMB, UpdateSourceTrigger=LostFocus}" Width="70"/>
                                <TextBlock Text="MB (0 = aus)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="Duplikate erst ab" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding DuplicateMinKB, UpdateSourceTrigger=LostFocus}" Width="70"/>
                                <TextBlock Text="KB" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Internet &amp; Datenschutz" Style="{StaticResource H2}"/>
                            <CheckBox IsChecked="{Binding NvidiaOnlineCheck}">
                                <TextBlock Text="NVIDIA-Treiberversion automatisch online prüfen (sendet nur das Grafikkartenmodell an nvidia.com)" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                       Text="Sonst sendet die App nichts ins Internet. Die Windows-Update-Suche startet nur, wenn du auf der Treiber-Seite auf „Über Windows Update prüfen“ klickst."/>
                            <Button Command="{Binding OpenDataFolderCommand}" HorizontalAlignment="Left" Margin="0,10,0,0">
                                <TextBlock Text="Datenordner öffnen (Einstellungen, Protokolle, Ergebnislisten)"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Scan-Ordner" Style="{StaticResource H2}"/>
                            <ListBox ItemsSource="{Binding ScanFolders}" SelectedItem="{Binding SelectedScanFolder}" Height="100"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Command="{Binding AddScanFolderCommand}"><TextBlock Text="Hinzufügen"/></Button>
                                <Button Command="{Binding RemoveScanFolderCommand}"><TextBlock Text="Entfernen"/></Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ausschlussliste (Ordner nie anfassen)" Style="{StaticResource H2}"/>
                            <ListBox ItemsSource="{Binding ExcludedFolders}" SelectedItem="{Binding SelectedExcludedFolder}" Height="100"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Command="{Binding AddExcludedFolderCommand}"><TextBlock Text="Hinzufügen"/></Button>
                                <Button Command="{Binding RemoveExcludedFolderCommand}"><TextBlock Text="Entfernen"/></Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Ausnahmeliste (Dateien nie wieder vorschlagen)" Style="{StaticResource H2}"/>
                            <ListBox ItemsSource="{Binding ExceptionFiles}" SelectedItem="{Binding SelectedException}" Height="120"/>
                            <Button Command="{Binding RemoveExceptionCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
                                <TextBlock Text="Ausgewählte Datei wieder vorschlagen lassen"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Fest geschützt (nicht änderbar)" Style="{StaticResource H2}"/>
                            <ItemsControl ItemsSource="{Binding ProtectedRoots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Good}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="440"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ───── Desktop aufräumen ───── -->
            <TextBlock Text="Desktop aufräumen" Style="{StaticResource H1}" FontSize="20" Margin="0,10,0,4"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,14,12"
                       Text="Wie Symbole gruppiert und lose Dateien in Ordner einsortiert werden. Änderungen gelten ab der nächsten Analyse."/>
            <Grid DataContext="{Binding Desktop}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Kategorien -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Kategorien für App-Symbole (Reihenfolge = von links nach rechts)" Style="{StaticResource H2}"/>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0">
                                <Button Command="{Binding MoveCategoryUpCommand}" Margin="0,0,0,6" ToolTip="Nach oben (weiter links)"><TextBlock Text="&#xE70E;" Style="{StaticResource Icon}" FontSize="12"/></Button>
                                <Button Command="{Binding MoveCategoryDownCommand}" Margin="0" ToolTip="Nach unten (weiter rechts)"><TextBlock Text="&#xE70D;" Style="{StaticResource Icon}" FontSize="12"/></Button>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Height="200"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox Text="{Binding CategoryName, UpdateSourceTrigger=PropertyChanged}" Width="190" Margin="0,0,8,0"/>
                            <Button Command="{Binding AddCategoryCommand}"><TextBlock Text="Hinzufügen"/></Button>
                            <Button Command="{Binding RenameCategoryCommand}"><TextBlock Text="Umbenennen"/></Button>
                            <Button Command="{Binding DeleteCategoryCommand}"><TextBlock Text="Löschen"/></Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Leere Spalten zwischen den Gruppen:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding GapColumns, UpdateSourceTrigger=LostFocus}" Width="50"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Nie anfassen -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Nie anfassen (Desktop-Elemente)" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"
                                   Text="Name wie auf dem Desktop (z. B. „Steam“) oder vollständiger Pfad. Diese Elemente werden weder verschoben noch umgestellt."/>
                        <ListBox ItemsSource="{Binding NeverTouch}" SelectedItem="{Binding SelectedNeverTouch}" Height="150"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox Text="{Binding NeverTouchName, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,8,0"/>
                            <Button Command="{Binding AddNeverTouchCommand}"><TextBlock Text="Hinzufügen"/></Button>
                            <Button Command="{Binding RemoveNeverTouchCommand}"><TextBlock Text="Entfernen"/></Button>
                        </StackPanel>
                        <Button Command="{Binding ResetDesktopDefaultsCommand}" HorizontalAlignment="Left" Margin="0,16,0,0">
                            <TextBlock Text="Kategorien &amp; Regeln auf Standard zurücksetzen"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Programm → Kategorie -->
                <Border Grid.Row="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Zuordnung Programm → Kategorie" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"
                                   Text="Das Muster wird im Ziel der Verknüpfung, im Programmnamen, Hersteller, Link und Symbolnamen gesucht. Die erste passende Regel (von oben) gewinnt."/>
                        <DataGrid ItemsSource="{Binding AppRules}" SelectedItem="{Binding SelectedAppRule}" Height="260"
                                  IsReadOnly="False" CanUserAddRows="False" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Muster" Binding="{Binding Pattern, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                <DataGridTemplateColumn Header="Kategorie" Width="190">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                      SelectedItem="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Command="{Binding AddAppRuleCommand}"><TextBlock Text="Regel hinzufügen"/></Button>
                            <Button Command="{Binding RemoveAppRuleCommand}"><TextBlock Text="Ausgewählte entfernen"/></Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Dateityp → Ordner -->
                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Zuordnung Dateityp → Ordner" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"
                                   Text="Endungen mit Leerzeichen trennen. „Name beginnt mit“ und „Andere Ordnernamen“ mit „;“. Eine Regel ohne Endungen fängt alles Übrige auf."/>
                        <DataGrid ItemsSource="{Binding FolderRules}" SelectedItem="{Binding SelectedFolderRule}" Height="260"
                                  IsReadOnly="False" CanUserAddRows="False" RowHeight="34">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Ordner" Binding="{Binding Folder, UpdateSourceTrigger=LostFocus}" Width="110"/>
                                <DataGridTextColumn Header="Endungen" Binding="{Binding Extensions, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                <DataGridTextColumn Header="Name beginnt mit" Binding="{Binding NamePrefixes, UpdateSourceTrigger=LostFocus}" Width="130"/>
                                <DataGridTextColumn Header="Andere Ordnernamen" Binding="{Binding Aliases, UpdateSourceTrigger=LostFocus}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Command="{Binding AddFolderRuleCommand}"><TextBlock Text="Regel hinzufügen"/></Button>
                            <Button Command="{Binding RemoveFolderRuleCommand}"><TextBlock Text="Ausgewählte entfernen"/></Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
