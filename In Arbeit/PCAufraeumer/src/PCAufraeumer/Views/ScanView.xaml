<UserControl x:Class="PCAufraeumer.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,24,14,14">
        <StackPanel>
            <TextBlock Text="Scan – unnötige Dateien finden" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,14,16"
                       Text="Der Scan löscht nichts. Er erstellt nur eine Liste mit Vorschlägen, die du danach in Ruhe prüfst."/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Ordner -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Was wird durchsucht?" Style="{StaticResource H2}"/>
                        <ListBox ItemsSource="{Binding Config.ScanFolders}" SelectedItem="{Binding Config.SelectedScanFolder}" Height="130"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Command="{Binding Config.AddScanFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Ordner/Laufwerk hinzufügen"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding Config.RemoveScanFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE738;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Entfernen"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock Text="Nie anfassen (Ausschlussliste)" Style="{StaticResource H2}" Margin="0,18,0,8"/>
                        <ListBox ItemsSource="{Binding Config.ExcludedFolders}" SelectedItem="{Binding Config.SelectedExcludedFolder}" Height="90"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Command="{Binding Config.AddExcludedFolderCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Ordner ausschließen"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding Config.RemoveExcludedFolderCommand}">
                                <TextBlock Text="Entfernen"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,10,0,0"
                                   Text="Immer geschützt: Windows, Programme, ProgramData, AppData, Systemdateien, geöffnete Dateien, OneDrive „Nur online“ sowie Spiele-/Programmordner. Details unter Einstellungen."/>
                    </StackPanel>
                </Border>

                <!-- Kategorien -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Wonach wird gesucht?" Style="{StaticResource H2}"/>
                        <CheckBox IsChecked="{Binding Config.CategoryVideos}" Margin="0,4">
                            <TextBlock TextWrapping="Wrap"><Run Text="Alte Videos/Clips" FontWeight="SemiBold"/><Run Text=" – länger nicht geöffnet als der eingestellte Zeitraum"/></TextBlock>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="24,2,0,8">
                            <TextBlock Text="Zeitraum:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Config.VideoPeriods}" SelectedItem="{Binding Config.VideoPeriod}" DisplayMemberPath="Label" Width="130"/>
                            <TextBox Text="{Binding Config.VideoCustomDays, UpdateSourceTrigger=LostFocus}" Width="70" Margin="8,0,4,0"
                                     Visibility="{Binding Config.VideoCustom, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Tage" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                       Visibility="{Binding Config.VideoCustom, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding Config.CategoryDuplicates}" Margin="0,4">
                            <TextBlock TextWrapping="Wrap"><Run Text="Doppelte Dateien" FontWeight="SemiBold"/><Run Text=" – gleicher Inhalt (Größe + Hash geprüft)"/></TextBlock>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="24,2,0,8">
                            <TextBlock Text="Erst ab" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding Config.DuplicateMinKB, UpdateSourceTrigger=LostFocus}" Width="70"/>
                            <TextBlock Text="KB Dateigröße" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding Config.CategoryTemp}" Margin="0,4">
                            <TextBlock TextWrapping="Wrap"><Run Text="Temp-/Cache-Dateien" FontWeight="SemiBold"/><Run Text=" – %TEMP%, Windows-Temp, Browser-Caches, Miniaturansichten, Windows-Update-Reste (unabhängig von der Ordnerauswahl)"/></TextBlock>
                        </CheckBox>

                        <CheckBox IsChecked="{Binding Config.CategoryDownloads}" Margin="0,10,0,4">
                            <TextBlock TextWrapping="Wrap"><Run Text="Alte Downloads/Installer" FontWeight="SemiBold"/><Run Text=" – .exe, .msi, .zip, .rar, .7z, .iso … im Downloads-Ordner"/></TextBlock>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="24,2,0,8">
                            <TextBlock Text="Älter als:" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding Config.DownloadPeriods}" SelectedItem="{Binding Config.DownloadPeriod}" DisplayMemberPath="Label" Width="130"/>
                            <TextBox Text="{Binding Config.DownloadCustomDays, UpdateSourceTrigger=LostFocus}" Width="70" Margin="8,0,4,0"
                                     Visibility="{Binding Config.DownloadCustom, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="Tage" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                       Visibility="{Binding Config.DownloadCustom, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <CheckBox IsChecked="{Binding Config.CategoryRecordings}" Margin="0,10,0,4">
                            <TextBlock TextWrapping="Wrap"><Run Text="Spielaufnahmen" FontWeight="SemiBold"/><Run Text=" – alle Clips von NVIDIA, Xbox Game Bar, Steam, AMD, OBS, Medal, SteelSeries, nach Spiel geordnet (ohne Altersgrenze). Clips im Unterordner „Behalten“ bleiben unberührt."/></TextBlock>
                        </CheckBox>
                        <StackPanel Margin="24,2,0,8" Visibility="{Binding Config.CategoryRecordings, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding Config.AddRecordingFolderCommand}" Padding="8,3" FontSize="12" Margin="8,0,0,0">
                                    <TextBlock Text="Ordner hinzufügen …"/>
                                </Button>
                                <TextBlock Text="{Binding Config.RecordingFoldersText}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Config.DetectedRecordingFolders}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,1">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="4,0" Margin="4,0,0,0" ToolTip="Eigenen Ordner entfernen"
                                                    Command="{Binding DataContext.Config.RemoveRecordingFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Path}"
                                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="10"/>
                                            </Button>
                                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}">
                                                <Run Text="{Binding Source, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  " /><Run Text="{Binding Path, Mode=OneWay}" Foreground="{DynamicResource TextMuted}"/>
                                            </TextBlock>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <TextBlock Text="Nur Dateien größer als" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox Text="{Binding Config.MinSizeMB, UpdateSourceTrigger=LostFocus}" Width="70"/>
                            <TextBlock Text="MB  (0 = alle)" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Zugriffsdatum -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="&#xE946;" Style="{StaticResource Icon}" FontSize="20" VerticalAlignment="Top"
                               Foreground="{DynamicResource Accent}" Margin="0,2,14,0"/>
                    <StackPanel>
                        <TextBlock Text="Wie zuverlässig ist „zuletzt geöffnet“?" Style="{StaticResource H2}"/>
                        <TextBlock Text="{Binding LastAccessSummary}" Style="{StaticResource Value}"/>
                        <TextBlock Text="{Binding LastAccessRegistry}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding LastAccessFsutil}" Style="{StaticResource Muted}" FontSize="12"/>
                        <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"
                                   Text="In der Ergebnisliste steht bei jeder Datei, auf welchem Datum die Einstufung beruht. Hash-Berechnung und Vorschaubilder setzen das Zugriffsdatum hinterher wieder zurück."/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Start / Fortschritt -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Command="{Binding CancelCommand}" Style="{StaticResource DangerButton}"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,8,0"/>
                                    <TextBlock Text="Abbrechen"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" Padding="22,10" Margin="0"
                                    IsEnabled="{Binding IsScanning, Converter={StaticResource Not}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,8,0"/>
                                    <TextBlock Text="Scan starten" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Phase}" FontWeight="SemiBold" FontSize="14"/>
                            <TextBlock Text="{Binding Counters}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar Margin="0,12,0,6" Value="{Binding Percent, Mode=OneWay}" Maximum="100" IsIndeterminate="{Binding Indeterminate}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding CurrentPath}" Style="{StaticResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding LastSummary}" Style="{StaticResource Muted}" Margin="0,8,0,0"
                               Visibility="{Binding LastSummary, Converter={StaticResource NullToVis}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
