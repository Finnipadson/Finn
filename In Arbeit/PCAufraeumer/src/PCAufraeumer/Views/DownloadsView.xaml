<UserControl x:Class="PCAufraeumer.Views.DownloadsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding OpenFolderCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Ordner öffnen"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding AnalyzeCommand}" Margin="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Neu analysieren"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Downloads aufräumen" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                           Text="Lose Dateien im Downloads-Ordner kommen in Unterordner (Bilder, Dokumente, Installer …). Es wird nichts gelöscht, alles lässt sich rückgängig machen. Die Regeln „Dateityp → Ordner“ findest du unter Optionen."/>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,14,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Was verschieben:" VerticalAlignment="Center" Margin="0,0,8,0" Style="{StaticResource Muted}"/>
                <ComboBox ItemsSource="{Binding AgeOptions}" SelectedItem="{Binding SelectedAge}" DisplayMemberPath="Name" Width="250"
                          VerticalContentAlignment="Center" ToolTip="Neuere Dateien bleiben liegen, damit du sie gleich wiederfindest (einzeln einschaltbar)"/>
            </StackPanel>
            <TextBlock Text="{Binding InfoText}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="0.33*" MinWidth="220" MaxWidth="330"/>
            </Grid.ColumnDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Geplante Änderungen" Style="{StaticResource H2}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <Button Command="{Binding SelectAllCommand}" Padding="8,3" FontSize="12"><TextBlock Text="Alle an"/></Button>
                    <Button Command="{Binding SelectNoneCommand}" Padding="8,3" FontSize="12"><TextBlock Text="Alle aus"/></Button>
                    <Button Command="{Binding RecycleDuplicatesCommand}" Padding="8,3" FontSize="12" Margin="8,0,0,0"
                            Visibility="{Binding DuplicateCount, Converter={StaticResource PositiveToVis}}"
                            ToolTip="Dateien mit genau gleichem Inhalt – die jeweils andere Datei bleibt erhalten">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="12" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding DuplicateText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Changes}" IsReadOnly="True" RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40" MinWidth="40" SortMemberPath="IsEnabled">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEnable}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Datei" Width="260" MinWidth="170" SortMemberPath="Item.DisplayName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Item.Icon}" Width="22" Height="22" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Item.DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Item.Path}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Größe" Binding="{Binding Item.Size, Converter={StaticResource Bytes}}" SortMemberPath="Item.Size" Width="85" MinWidth="80"
                                            ElementStyle="{StaticResource Mono}"/>
                        <DataGridTextColumn Header="Datum" Binding="{Binding Item.Modified, StringFormat=dd.MM.yyyy}" SortMemberPath="Item.Modified" Width="95" MinWidth="90"
                                            ElementStyle="{StaticResource Mono}"/>
                        <DataGridTemplateColumn Header="Zielordner" Width="170" MinWidth="150" SortMemberPath="Target">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Options}" Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True" IsEnabled="{Binding CanEnable}" VerticalAlignment="Center"
                                              ToolTip="Du kannst auch einen neuen Ordnernamen eintippen"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="Änderung" Width="*" MinWidth="200" SortMemberPath="Description">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
                                        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Warn}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Note, Converter={StaticResource NullToVis}}" ToolTip="{Binding Note}"/>
                                        <TextBlock Text="{Binding DuplicateText}" Foreground="{DynamicResource Accent}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsDuplicate, Converter={StaticResource BoolToVis}}" ToolTip="{Binding DuplicateKeepPath}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Verlauf" Style="{StaticResource H2}" Margin="0,4,0,8"/>
                <ListBox ItemsSource="{Binding History}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="0,2">
                                <Button DockPanel.Dock="Right" Padding="8,3" Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                        Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}" IsEnabled="{Binding Undone, Converter={StaticResource Not}}">
                                    <TextBlock Text="Rückgängig"/>
                                </Button>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="12"/>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding ApplyCommand}" Style="{StaticResource PrimaryButton}" Margin="0" Padding="22,10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                        <TextBlock Text="Übernehmen …" FontSize="14"/>
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <ProgressBar IsIndeterminate="True" Width="80" Height="4" Margin="0,0,8,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
