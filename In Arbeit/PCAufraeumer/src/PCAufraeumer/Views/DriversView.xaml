<UserControl x:Class="PCAufraeumer.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Treiberprüfung" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,16"
                       Text="Die App zeigt nur an und verlinkt – sie installiert keine Treiber. Ampel: grün = aktuell, gelb = Update verfügbar oder älter als 1 Jahr, grau = nicht prüfbar."/>
        </StackPanel>

        <!-- NVIDIA -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="{Binding HasNvidia, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenNvidiaPageCommand}" Margin="0,0,0,8">
                        <TextBlock Text="NVIDIA-Treiberseite öffnen"/>
                    </Button>
                    <Button Command="{Binding CheckNvidiaCommand}" Margin="0" IsEnabled="{Binding IsCheckingNvidia, Converter={StaticResource Not}}">
                        <TextBlock Text="Erneut prüfen"/>
                    </Button>
                </StackPanel>
                <Ellipse DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,4,16,0"
                         Fill="{Binding NvidiaStatus, Converter={StaticResource StatusBrush}}"/>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding NvidiaName}" Style="{StaticResource H2}" Margin="0"/>
                        <Border Style="{StaticResource Badge}">
                            <TextBlock Text="{Binding NvidiaStatus, Converter={StaticResource AmpelText}}" FontSize="11"/>
                        </Border>
                    </StackPanel>
                    <WrapPanel Margin="0,6,0,0">
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="Installiert" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding NvidiaInstalled}" Style="{StaticResource Value}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="Treiberdatum" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding NvidiaDate}" Style="{StaticResource Value}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,32,0">
                            <TextBlock Text="Neueste laut NVIDIA" Style="{StaticResource Label}"/>
                            <TextBlock Text="{Binding NvidiaLatest}" Style="{StaticResource Value}"/>
                        </StackPanel>
                    </WrapPanel>
                    <TextBlock Text="{Binding NvidiaMessage}" Style="{StaticResource Value}" Margin="0,10,0,2"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="11"
                               Text="Hinweis: NVIDIA bietet keine offizielle Schnittstelle. Die App nutzt dieselbe (inoffizielle) Abfrage wie die Treibersuche auf nvidia.com. Funktioniert sie nicht, bleibt die Ampel grau – es wird nie „aktuell“ angezeigt, ohne wirklich geprüft zu haben."/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Windows Update -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding OpenWindowsUpdateCommand}">
                        <TextBlock Text="Windows Update öffnen"/>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SearchWindowsUpdateCommand}" Margin="0"
                            IsEnabled="{Binding IsSearchingWu, Converter={StaticResource Not}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                            <TextBlock Text="Über Windows Update prüfen"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="Andere Treiber (Windows Update)" Style="{StaticResource H2}"/>
                    <TextBlock Text="{Binding WuStatus}" Style="{StaticResource Muted}"/>
                    <ProgressBar IsIndeterminate="True" Margin="0,8,0,0" Height="4"
                                 Visibility="{Binding IsSearchingWu, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl ItemsSource="{Binding OtherUpdates}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Ellipse Width="9" Height="9" Fill="{DynamicResource Warn}" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Title}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Drivers}" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="40" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="12" Height="12" Fill="{Binding Status, Converter={StaticResource StatusBrush}}" ToolTip="{Binding StatusText}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Bereich" Binding="{Binding Category}" Width="130"/>
                <DataGridTextColumn Header="Gerät" Binding="{Binding DeviceName}" Width="2*"/>
                <DataGridTextColumn Header="Anbieter" Binding="{Binding Manufacturer}" Width="*"/>
                <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="130"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding Date, StringFormat=dd.MM.yyyy, TargetNullValue=–}" Width="95"/>
                <DataGridTemplateColumn Header="Status" Width="2*" SortMemberPath="StatusText">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="6,2" Margin="4,0,0,0"
                                        Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding Link}" ToolTip="Öffnen"
                                        Visibility="{Binding Link, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource Icon}" FontSize="12"/>
                                </Button>
                                <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}" VerticalAlignment="Center"/>
                            </DockPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,10,0,0">
            <ProgressBar IsIndeterminate="True" Width="120" Height="4" Margin="0,0,10,0"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
            <TextBlock Style="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"
                       Text="Microsoft-Standardtreiber für System/USB/Eingabe sind ausgeblendet, damit die Liste übersichtlich bleibt."/>
        </StackPanel>
    </Grid>
</UserControl>
