<Window x:Class="PCAufraeumer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCAufraeumer.ViewModels"
        xmlns:v="clr-namespace:PCAufraeumer.Views"
        Title="PC Aufräumer &amp; Systemübersicht" Width="1400" Height="880" MinWidth="1050" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}"><v:DriversView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}"><v:ScanView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}"><v:ResultsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}"><v:LogView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DesktopViewModel}"><v:DesktopView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Seitenleiste -->
        <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Top" Margin="18,22,18,22" Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Accent}">
                        <TextBlock Text="&#xEA99;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentText}"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PC Aufräumer" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="&amp; Systemübersicht" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Übersicht" GroupName="nav"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=dashboard, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE90F;" Content="Treiber" GroupName="nav"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=drivers, Mode=TwoWay}"/>
                    <TextBlock Text="AUFRÄUMEN" Style="{StaticResource Label}" Margin="22,18,0,4" FontSize="11"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE721;" Content="Scan" GroupName="nav"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=scan, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="Ergebnisse" GroupName="nav"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=results, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7F4;" Content="Desktop aufräumen" GroupName="nav"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=desktop, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE81C;" Content="Protokoll" GroupName="nav"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=log, Mode=TwoWay}"/>
                    <TextBlock Text="APP" Style="{StaticResource Label}" Margin="22,18,0,4" FontSize="11"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Einstellungen" GroupName="nav"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=settings, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,18">
                    <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding ToggleThemeCommand}" Margin="0,0,0,8" ToolTip="Hell/Dunkel umschalten">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE793;" Style="{StaticResource Icon}" Margin="0,0,12,0"/>
                            <TextBlock Text="Hell / Dunkel umschalten"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding AdminText}" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Inhalt -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>
    </Grid>
</Window>
