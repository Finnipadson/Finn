<Window x:Class="PCAufraeumer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCAufraeumer.ViewModels"
        xmlns:v="clr-namespace:PCAufraeumer.Views"
        Title="PC Aufräumer &amp; Systemübersicht" Width="1400" Height="880" MinWidth="1050" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DriversViewModel}"><v:DriversView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScanViewModel}"><v:ScanView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ResultsViewModel}"><v:ResultsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogViewModel}"><v:LogView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DesktopViewModel}"><v:DesktopView/></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProgramsPageViewModel}"><v:ProgramsView/></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Seitenleiste: schmale Symbolleiste (Design „Graphit“), voller Name als Tooltip -->
        <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="False">
                <Border DockPanel.Dock="Top" Width="38" Height="38" CornerRadius="9" Margin="0,12,0,18" HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource Accent}" BorderThickness="1.5" ToolTip="PC Aufräumer &amp; Systemübersicht">
                    <TextBlock Text="&#xEA99;" Style="{StaticResource Icon}" FontSize="18" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Accent}"/>
                </Border>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Übersicht" GroupName="nav" ToolTip="Systemübersicht"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=dashboard, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE90F;" Content="Treiber" GroupName="nav" ToolTip="Treiber"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=drivers, Mode=TwoWay}"/>
                    <Border Width="30" Height="1" Background="{DynamicResource Border}" Margin="0,8"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE721;" Content="Scan" GroupName="nav" ToolTip="Scan"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=scan, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE8FD;" Content="Ergebnisse" GroupName="nav" ToolTip="Ergebnisse"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=results, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE7F4;" Content="Desktop" GroupName="nav" ToolTip="Desktop aufräumen"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=desktop, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE71D;" Content="Programme" GroupName="nav" ToolTip="Programme"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=programs, Mode=TwoWay}"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE81C;" Content="Protokoll" GroupName="nav" ToolTip="Protokoll"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=log, Mode=TwoWay}"/>
                    <Border Width="30" Height="1" Background="{DynamicResource Border}" Margin="0,8"/>
                    <RadioButton Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Optionen" GroupName="nav" ToolTip="Einstellungen"
                                 IsChecked="{Binding CurrentKey, Converter={StaticResource Equals}, ConverterParameter=settings, Mode=TwoWay}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,14" HorizontalAlignment="Center">
                    <Button Style="{StaticResource RailButton}" Command="{Binding ToggleThemeCommand}" ToolTip="Hell / Dunkel umschalten">
                        <TextBlock Text="&#xE793;" Style="{StaticResource Icon}"/>
                    </Button>
                    <Border Width="40" Height="32" Background="Transparent" ToolTip="{Binding AdminText}">
                        <TextBlock Text="&#xEA18;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource TextMuted}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Inhalt -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False"/>
    </Grid>
</Window>
